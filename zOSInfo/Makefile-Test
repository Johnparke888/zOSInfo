CXX_PROG=zosInfoTest

CXXFLAGS+=-O3 -std=gnu++20 -fzos-le-char-mode=ascii $(INCLUDE)
CC=ibm-clang64
CXX=ibm-clang++64
LD=ibm-clang++64

INCLUDE+=-I. -I./include -I/usr/local/include -I/usr/include 

CXXSOURCES = zosInfoTest.cpp zosInfo.cpp
CXXOBJECTS = $(CXXSOURCES:.cpp=.o)  

$(CXX_PROG): $(CXXOBJECTS)
	$(CXX) $(INCLUDE) -o $@ $(CXXOBJECTS) 

check:: $(CXX_PROG)
	-./$(CXX_PROG)

all:: clean $(CXX_PROG) 
	
clean::
	$(RM) $(CXXOBJECTS) $(CXX_PROG) 

ship:: all
